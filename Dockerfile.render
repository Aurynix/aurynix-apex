# Image for the free Render demo (render.yaml). Same as Dockerfile, with two differences:
# the model is inside the image (deploy/models, `make deploy-model`), because Render has
# nothing to mount on the free plan, and there are no build cache mounts.
FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# libgomp: OpenMP runtime used by compiled ML dependencies
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first (cached unless pyproject.toml / uv.lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Then the project itself (API and Streamlit demo share this image)
COPY README.md config.json ./
COPY src ./src
COPY app ./app
COPY deploy/models ./models
RUN uv sync --frozen --no-dev

EXPOSE 8000 8501
# Default: the API. The demo service overrides this in render.yaml.
CMD ["uvicorn", "apex.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
