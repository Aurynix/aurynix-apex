# Copy to .env and adjust as needed.

# Override the config file location (defaults to ./config.json)
# APEX_CONFIG=config.json

# Postgres connection string. Never commit the real value.
# Leave empty to use local SQLite. On Render, set it in the service's Environment settings.
DATABASE_URL=

# Fill an empty database with demo rows at API startup. Off unless set to true.
# SEED_DEMO_DATA=false

# Host ports for `make run` / `make demo` / docker compose (change if 8000 or 8501 is taken)
API_PORT=8000
DEMO_PORT=8501
MLFLOW_PORT=5000
