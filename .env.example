# Copy to .env and adjust as needed.

# Override the config file location (defaults to ./config.json)
# APEX_CONFIG=config.json

# Postgres connection string. Never commit the real value.
# Leave empty to use local SQLite. On Render, set it in the service's Environment settings.
DATABASE_URL=

# Fill an empty database with demo rows at API startup. Off unless set to true.
# SEED_DEMO_DATA=false

# Protection for a public deployment; all off when empty (docs/deployment.md).
# API_KEY is required by /outcomes and /monitoring/run. With DATABASE_URL set and no
# API_KEY, those two endpoints refuse every request. The demo reads the same variable.
API_KEY=
# RATE_LIMIT_PER_MINUTE=30
# MAX_BATCH_SIZE=100
# VISITOR_RETENTION_DAYS=30
# MAX_VISITOR_ROWS=100000
# Monitoring reads only rows from this source (the public demo: demo_seed).
# MONITORING_SOURCE=
# Only behind Cloudflare: anywhere else a client could fake this header.
# TRUST_CF_CONNECTING_IP=false

# Host ports for `make run` / `make demo` / docker compose (change if 8000 or 8501 is taken)
API_PORT=8000
DEMO_PORT=8501
MLFLOW_PORT=5000
